# ============================================================================
# FRONTEND - Production / Mobile Build Environment Configuration
# ============================================================================
# These are PUBLIC client-side variables (safe to commit)
# DO NOT add any secrets here - they will be exposed in browser!
# Prefix all variables with VITE_ for Vite to expose them to the frontend
#
# Used by: `vite build` (mode defaults to "production"), including mobile
# builds via `npm run build:mobile`. Today this points at the SAME Firebase
# project as .env.local, since ServiceVerse currently runs dev/stage/prod
# off a single Firebase project (serviceverse-dev-fa38e). If dev and prod
# are ever split into separate Firebase projects, only this file needs to
# change to point mobile/production builds at the new prod project.

# ============================================================================
# FIREBASE CONFIGURATION (Public - Safe to commit)
# ============================================================================
VITE_FIREBASE_API_KEY=AIzaSyC7TxDz8eeJFeXbkFFqWA3ejdHfmjqA5QM
VITE_FIREBASE_AUTH_DOMAIN=serviceverse-dev-fa38e.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=serviceverse-dev-fa38e
VITE_FIREBASE_STORAGE_BUCKET=serviceverse-dev-fa38e.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=135316608425
VITE_FIREBASE_APP_ID=1:135316608425:web:209dd0614193d61d7560b8

# ============================================================================
# PAYMENT GATEWAY - Razorpay (Public Test Key Only)
# ============================================================================
VITE_RAZORPAY_KEY_ID=rzp_test_T91ivZFrH0iL07

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
VITE_APP_NAME=ServiceVerse
VITE_APP_URL=https://www.theserviceverse.in

# ============================================================================
# API CONFIGURATION
# ============================================================================
# Backend API URL - Points to Cloud Functions (includes /api path for the exported function)
VITE_API_URL=https://us-central1-serviceverse-dev-fa38e.cloudfunctions.net/api
